  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "28eb31df-5f86-4160-99f2-b21689347ea3"
      },
      "text": "LiveKpis()\n| project ['Active fires'] = active_zones,\n          ['Critical'] = critical_zones,\n          ['Growing'] = growing_zones,\n          ['Communes at risk'] = communes_at_risk,\n          ['People at risk'] = pop_at_risk,\n          ['People downwind'] = pop_downwind,\n          ['Feed age min'] = feed_age_min",
      "id": "6af7cfd3-907e-4aec-9be6-4e3ae84ae5a8",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "28eb31df-5f86-4160-99f2-b21689347ea3"
      },
      "text": "DispatchPriority(6h, 3.0, 30000.0)\n| project fire_lat, fire_lon, frp_total, priority_score, severity,\n          nearest_commune, pop_exposed, pop_downwind, trend, growth_pct",
      "id": "95eb5de9-8654-4a7a-bf01-742beafc30d7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "28eb31df-5f86-4160-99f2-b21689347ea3"
      },
      "text": "DispatchPriority(6h, 3.0, 30000.0)\n| summarize ['Fires'] = count() by ['Severity'] = severity",
      "id": "3a375e2e-6b04-42ad-8391-c8a07ab38d53",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "28eb31df-5f86-4160-99f2-b21689347ea3"
      },
      "text": "ZoneExposure(6h, 3.0, 30000.0)\n| extend dryness = ((100.0 - coalesce(humidity_pct, 60.0)) / 100.0)\n                 * (1.0 + coalesce(vpd_kpa, 1.0) / 3.0)\n| extend spread_kmh = round(0.05 + 0.045 * coalesce(wind_speed_kmh, 0.0) * dryness, 2)\n| extend dist_km = round(dist_nearest_m / 1000.0, 1)\n| extend eta_h = round(dist_km / spread_kmh, 1)\n| where eta_h <= 48\n| project ['Commune'] = nearest_commune,\n          ['ETA hours'] = eta_h,\n          ['Distance km'] = dist_km,\n          ['Spread km/h'] = spread_kmh,\n          ['People'] = pop_exposed,\n          ['Downwind'] = pop_downwind,\n          ['Trend'] = trend\n| order by ['ETA hours'] asc\n| take 15",
      "id": "fa70c141-61ea-4b68-ba5d-13d0564be56c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "28eb31df-5f86-4160-99f2-b21689347ea3"
      },
      "text": "DispatchPriority(6h, 3.0, 30000.0)\n| project ['Severity'] = severity,\n          ['Score'] = priority_score,\n          ['Commune'] = nearest_commune,\n          ['Dept'] = nearest_dept,\n          ['FRP MW'] = frp_total,\n          ['Trend'] = trend,\n          ['Growth %'] = growth_pct,\n          ['Exposed'] = pop_exposed,\n          ['Downwind'] = pop_downwind,\n          ['Recommended action'] = recommendation\n| order by ['Score'] desc\n| take 20",
